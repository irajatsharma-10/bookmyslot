# PostgreSQL connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/bookmyslot"

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate a new secret
NEXTAUTH_SECRET="your-super-secret-key-for-nextauth"

# Redis Configuration (Used by BullMQ)
REDIS_URL="redis://localhost:6379"
# REDIS_PASSWORD="optional-redis-password"




# Sentry Configuration (Observability)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.2"

# SMTP Configuration (for booking confirmation emails)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM='"BookMySlot" <noreply@bookmyslot.com>'

# Cron Authentication
# CRON_SECRET="your-cron-secret"

# Logging
# LOG_LEVEL="info"
