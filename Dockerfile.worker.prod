FROM node:22-slim AS base
WORKDIR /app

# ==============================================================================
# 1. Dependencies Stage
# ==============================================================================
FROM base AS deps
COPY package.json package-lock.json* ./
RUN npm ci

# ==============================================================================
# 2. Builder Stage (Compile TS)
# ==============================================================================
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Ensure prisma client is generated for the worker
RUN npx prisma generate
# We use tsx to run the worker in development, but for production we should compile it
RUN npx tsc --project tsconfig.json --outDir dist || true 

# ==============================================================================
# 3. Runner Stage
# ==============================================================================
FROM base AS runner
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

# Copy node_modules (we need production deps, but for simplicity we'll copy all deps
# since BullMQ, Prisma, etc are required at runtime anyway)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# If tsc succeeded, copy dist. Otherwise, we'll fall back to running tsx directly.
# For this MVP hardening, we'll just run via tsx as a simple robust approach for Node 22
COPY --from=builder /app/src ./src
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/tsconfig.json ./tsconfig.json

USER worker

# tsx is installed in dependencies, use it to run the worker
CMD ["npx", "tsx", "src/worker.ts"]
